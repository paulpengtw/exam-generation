server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  resolver 8.8.8.8 ipv6=off valid=30s;
  set $backend "${BACKEND_SCHEME}://${BACKEND_HOST}";

  location /auth/ {
    proxy_pass $backend;
    proxy_set_header Host "${BACKEND_HOST}";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
  }

  location /api/ {
    proxy_pass $backend;
    proxy_set_header Host "${BACKEND_HOST}";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
    proxy_read_timeout 300s;
    proxy_buffering off;
    proxy_cache off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    chunked_transfer_encoding on;
  }

  location /health {
    proxy_pass $backend;
    proxy_set_header Host "${BACKEND_HOST}";
    proxy_ssl_server_name on;
  }

  # Artifact metadata — must never be cached (issue #770)
  location = /release/policy.json {
    proxy_pass $backend/release/policy.json;
    proxy_set_header Host "${BACKEND_HOST}";
    proxy_ssl_server_name on;
    add_header Cache-Control 'no-store' always;
  }

  location = /build-meta.json {
    proxy_pass $backend/build-meta.json;
    proxy_set_header Host "${BACKEND_HOST}";
    proxy_ssl_server_name on;
    add_header Cache-Control 'no-store' always;
  }

  # Hashed static assets — immutable, 1-year cache (issue #770)
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control 'public, max-age=31536000, immutable';
  }

  # SPA entry point — revalidate on every request (issue #770)
  location = /index.html {
    try_files $uri =404;
    add_header Cache-Control 'no-cache';
  }

  # SPA fallback — serve index.html only for non-asset paths (issue #770)
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control 'no-cache';
  }
}
