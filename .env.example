# Gemini API credentials — required for the default configuration (execute tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Anthropic API credentials — required for the default configuration (plan and 驗證 tiers)
# Also used for Anthropic web-search fact-check
LLM_API_KEY=your-anthropic-api-key-here
LLM_BASE_URL=https://api.anthropic.com/v1

# OpenAI API credentials — used for gpt-* and o-series models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model routing: plan/驗證 on Claude, execute on Gemini; both provider keys required.
LLM_MODEL_PLAN=claude-opus-4-6
LLM_MODEL_EXECUTE=gemini-3.1-pro-preview
# Unset verify uses the default below; explicitly empty = follow execute at call time.
# LLM_MODEL_VERIFY=claude-opus-4-6
# 修正 defaults to empty = follow execute at call time.
# LLM_MODEL_CORRECT=
# Effort defaults: high for plan/execute/驗證; 修正 inherits execute.
# LLM_EFFORT_PLAN=high
# LLM_EFFORT_EXECUTE=high
# Unset verify effort uses high; explicitly empty = inherit execute effort at call time.
# LLM_EFFORT_VERIFY=high
# LLM_EFFORT_CORRECT=

# Allowlist of model IDs exposed by GET /api/models (comma-separated).
# Unset = built-in roster: gemini-3.1-pro-preview, claude-opus-4-6,
# claude-sonnet-4-6, claude-opus-5, claude-fable-5, claude-sonnet-5.
# LLM_MODELS_ALLOWED=gemini-3.1-pro-preview,claude-opus-5,gpt-4o

# Optional GPT image generation for social studies HTML image specs
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image2

# HTTP timeouts for API calls (seconds; 0 = no timeout)
LLM_TIMEOUT_SECONDS=600
IMAGE_TIMEOUT_SECONDS=300

# Rate limiting (seconds between API calls)
LLM_RATE_LIMIT_DELAY=2

# Output
OUTPUT_DIR=./output

# Server database (development default; overridden by docker-compose to Postgres)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Postgres password (used by db service and backend DATABASE_URL in docker-compose)
DB_PASSWORD=changeme

# Pool checkout attribution — set to 1 or true to enable in staging.
# Emits a warning (forwarded to Sentry) naming the code path whenever a pooled
# connection is garbage-collected without being explicitly returned to the pool.
# Off by default; do not enable in high-throughput production.
# DB_POOL_CHECKOUT_ATTRIBUTION=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Login token lifetime in days
JWT_EXPIRE_DAYS=7
# Renew the login session when less than this many minutes remain
SESSION_RENEWAL_THRESHOLD_MINUTES=360

# AWS / SES (email delivery)
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@example.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Email backend: "ses" for AWS SES, "console" for local dev (logs emails to stdout)
EMAIL_BACKEND=console

# Email whitelist: comma-separated list of allowed recipient addresses.
# Supports exact matches and domain wildcards (e.g. *@school.edu).
# Leave unset (or empty) to allow all addresses (useful for local dev).
# EMAIL_WHITELIST=alice@example.com,bob@example.com,*@school.edu
